# Railway Variables uchun namuna
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=.railway.app,.up.railway.app,localhost,127.0.0.1

# Netlify domeningizni shu yerga yozing. Masalan:
# CORS_ALLOWED_ORIGINS=https://samarqand.netlify.app
# CSRF_TRUSTED_ORIGINS=https://samarqand.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default True: har qanday *.netlify.app domeniga ruxsat beradi.
# Xavfsizlikni kuchaytirish uchun False qilib, yuqorida faqat o'z domeningizni yozing.
CORS_ALLOW_NETLIFY=True
CORS_ALLOW_ALL_ORIGINS=False

# Railway PostgreSQL qo'shsangiz DATABASE_URL avtomatik keladi.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL_REQUIRE=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
